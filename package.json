{
    "name": "sc-automation-core",
    "version": "1.65.1",
    "description": "The core of SC automation tests. Built with Playwright.",
    "license": "ISC",
    "main": "lib/index.js",
    "typings": "lib/index.d.ts",
    "files": [
        "lib",
        "global.d.ts"
    ],
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "automation",
        "testing",
        "sc-automation-core"
    ],
    "author": {
        "email": "pentagon@luminetsoft.com",
        "name": "pentagon"
    },
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix  && prettier --write '{src}/**/*.ts'",
        "prebuild": "rimraf lib",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "reg": "npm set registry http://npm.lumigame.com",
        "pub": "npm publish --registry http://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm publish --registry http://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "devDependencies": {
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@playwright/test": "1.44.0",
        "@semantic-release/changelog": "^5.0.1",
        "@semantic-release/commit-analyzer": "^8.0.1",
        "@semantic-release/git": "^9.0.0",
        "@semantic-release/gitlab": "^6.0.4",
        "@semantic-release/npm": "^7.0.5",
        "@semantic-release/release-notes-generator": "^9.0.1",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "notepack.io": "^3.0.1",
        "prom-client": "^15.1.3",
        "rimraf": "3.0.2",
        "sc-semantic-release": "^1.3.0",
        "semantic-release": "^17.1.1",
        "tslib": "2.4.1",
        "typescript": "^4.6.3"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "dependencies": {
        "csv-stringify": "^6.5.0",
        "glob": "10.4.5",
        "pngjs": "^7.0.0",
        "prettier": "^3.2.5",
        "socket.io-client": "^4.7.3",
        "tesseract.js": "^4.1.1",
        "undici": "^7.3.0",
        "websocket": "^1.0.34"
    }
}
